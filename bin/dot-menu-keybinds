#!/usr/bin/env python3
import collections
import json
from pathlib import Path
import subprocess
import sys
import unicodedata


def render_bindings():
    def hyprctl(*args):
        return subprocess.check_output(["hyprctl", *args], text=True)

    binds = json.loads(hyprctl("-j", "binds"))
    # Registered with each mode's entry binding; never infer targets from Lua IDs.
    edges = {}
    for line in hyprctl("repl", """(function()
        local rows = {}
        for name, edge in pairs(dot_submap_paths or {}) do
            rows[#rows + 1] = name .. '\\t' .. edge.parent .. '\\t' .. edge.key
        end
        return table.concat(rows, '\\n')
    end)()""").splitlines():
        fields = line.split("\t")
        if len(fields) == 3:
            edges[fields[0]] = (fields[1], fields[2])

    modifiers = [(64, "Super"), (4, "Ctrl"), (8, "Alt"), (1, "Shift"),
                 (32, "Mod3"), (128, "Mod5")]
    key_names = {"LEFT": "←", "DOWN": "↓", "UP": "↑", "RIGHT": "→",
                 "ESCAPE": "Esc", "RETURN": "Enter", "SPACE": "Space", "TAB": "Tab", "PRINT": "Print",
                 "MOUSE:272": "LMB", "MOUSE:273": "RMB",
                 "MOUSE_DOWN": "󰍽↓", "MOUSE_UP": "󰍽↑",
                 "XF86AUDIORAISEVOLUME": "Volume↑", "XF86AUDIOLOWERVOLUME": "Volume↓",
                 "XF86AUDIOMUTE": "Mute", "XF86AUDIOMICMUTE": "MicMute",
                 "XF86AUDIOSTOP": "MediaStop", "XF86AUDIOPLAY": "Play/Pause",
                 "XF86AUDIONEXT": "NextTrack", "XF86AUDIOPREV": "PreviousTrack",
                 "XF86MONBRIGHTNESSUP": "Brightness↑", "XF86MONBRIGHTNESSDOWN": "Brightness↓"}

    def key_name(key):
        return key_names.get(key.upper(), key.upper() if len(key) == 1 else key)

    def key_set(keys):
        remaining = list(dict.fromkeys(keys))
        # Hide Vim aliases only when the same action also has its matching arrow.
        for letter, arrow in zip("HJKL", ("LEFT", "DOWN", "UP", "RIGHT")):
            if letter in remaining and arrow in remaining:
                remaining.remove(letter)
        parts = []
        for group, label in [(list("HJKL"), "HJKL"),
                             (["LEFT", "DOWN", "UP", "RIGHT"], "←↓↑→")]:
            if all(key in remaining for key in group):
                remaining = [key for key in remaining if key not in group]
                parts.append(label)
        digits = sorted(int(key) for key in remaining if key in "0123456789" and len(key) == 1)
        if len(digits) >= 3 and digits == list(range(digits[0], digits[-1] + 1)):
            remaining = [key for key in remaining if key not in {str(n) for n in digits}]
            parts.append(f"{digits[0]}–{digits[-1]}")
        return "/".join(parts + [key_name(key) for key in remaining])

    def chord(modmask, keys):
        return "+".join([name for mask, name in modifiers if modmask & mask] + [key_set(keys)])

    def entry_chord(keys):
        return "+".join(key_name(part.strip()) if part.strip().upper() not in
                        {"SUPER", "CTRL", "ALT", "SHIFT"} else part.strip().title()
                        for part in keys.split("+"))

    groups = collections.OrderedDict()
    for index, bind in enumerate(binds):
        key = bind.get("key") or (f"code:{bind['keycode']}" if bind.get("keycode") else "")
        description = bind.get("description") or ""
        if not key or bind.get("catch_all") or description.startswith("_") or key.startswith("switch:"):
            continue
        if bind.get("submap") not in (None, "", "reset") and description == "Exit":
            continue
        group = (bind.get("submap", ""), bind.get("modmask", 0), description,
                 bool(bind.get("release")), bool(bind.get("longPress")), bool(bind.get("mouse")),
                 index if not description else None)
        groups.setdefault(group, []).append(key.upper())

    categories = ["Windows", "Workspaces", "Apps & menus", "Groups", "Monitors",
                  "Capture", "Session", "Other", "Media & brightness"]
    mode_categories = {"Window": "Windows", "Resize": "Windows", "Workspaces": "Workspaces",
                       "Apps": "Apps & menus", "Groups": "Groups", "Outputs": "Monitors",
                       "Capture": "Capture", "Session": "Session", "Media": "Media & brightness"}
    # Common actions first; unspecified actions retain their order in the config.
    direct_categories = {
        "Windows": ["Focus", "Close", "Full width", "Fullscreen", "Floating", "Swap",
                    "Window", "Resize", "Move window", "Resize window"],
        "Workspaces": ["Workspace", "Move and follow", "Previous workspace",
                       "Next occupied workspace", "Previous occupied workspace",
                       "Scratchpad", "Move to scratchpad", "Workspaces"],
        "Groups": ["Groups", "Next group member", "Previous group member"],
        "Apps & menus": ["Terminal", "Launcher", "Apps", "Clipboard", "Keybinding help"],
        "Capture": ["Capture", "Screenshot", "Copy screenshot"],
        "Media & brightness": ["Media"],
    }
    entries = {(parent, entry_chord(key)): name for name, (parent, key) in edges.items()}

    def category_for(mode, target, keys, description):
        if mode or target:
            return mode_categories.get((mode or target).split(" / ", 1)[0], "Other")
        if all(key.startswith("XF86AUDIO") or key.startswith("XF86MONBRIGHTNESS") for key in keys):
            return "Media & brightness"
        for category, actions in direct_categories.items():
            if description in actions:
                return category
        return "Other"

    Row = collections.namedtuple("Row", "category key action mode target")
    rows = []
    for (mode, modmask, description, release, held, mouse, _), keys in groups.items():
        mode = "" if mode == "reset" else mode
        target = entries.get((mode, chord(modmask, keys)))
        sequence = chord(modmask, keys).replace("+", " ")
        if release:
            sequence += " (release)"
        if held:
            sequence += " (hold)"
        action = description or "Action"
        category = category_for(mode, target, keys, description)
        rows.append(Row(category, sequence, action, mode, target))

    # Each entry owns its children inside the same category, including nested modes.
    mode_rows = collections.defaultdict(list)
    for index, row in enumerate(rows):
        mode_rows[row.mode].append(index)
    display_rows = []
    visited = set()

    def append_row(index, depth=0, category=None):
        if index in visited:
            return
        visited.add(index)
        row = rows[index]
        category = category or row.category
        display_rows.append((category, row.key, row.action, depth))
        if row.target:
            for child in mode_rows[row.target]:
                append_row(child, depth + 1, category)

    def root_priority(index):
        row = rows[index]
        actions = direct_categories.get(row.category, [])
        return actions.index(row.action) if row.action in actions else len(actions)

    for index in sorted(mode_rows[""], key=root_priority):
        append_row(index)
    # Keep unregistered modes visible with enough context to identify their keys.
    for mode, indices in list(mode_rows.items()):
        remaining = [index for index in indices if index not in visited]
        if remaining:
            category = rows[remaining[0]].category
            display_rows.append((category, f"[{mode}]", mode, 0))
            for index in remaining:
                append_row(index, 1, category)
    display_rows.sort(key=lambda row: categories.index(row[0]))

    def width(text):
        return sum(0 if unicodedata.combining(char) else
                   2 if unicodedata.east_asian_width(char) in "WF" else 1 for char in text)

    column = max((depth * 2 + width(key) for _, key, _, depth in display_rows), default=0)
    section = None
    lines = []
    for category, key, description, depth in display_rows:
        if category != section:
            lines.append(f"── {category} ──")
            section = category
        label = "  " * depth + key
        lines.append("  " + label + " " * (column - width(label) + 3) + description)
    return "".join(line + "\n" for line in lines)


def main():
    option = sys.argv[1] if len(sys.argv) > 1 else ""
    if option in ("--help", "-h"):
        print(f"Usage: {Path(sys.argv[0]).name} [--list]")
        print("Indented keys belong to the submap above; release its shortcut before the next key.")
        return 0
    if option not in ("", "--list"):
        print(f"Unknown option: {option}", file=sys.stderr)
        return 2

    bindings = render_bindings()
    if option == "--list":
        sys.stdout.write(bindings)
        return 0
    return subprocess.run(
        ["varde", "dmenu", "-p", "Keybindings"], input=bindings, text=True
    ).returncode


if __name__ == "__main__":
    sys.exit(main())
