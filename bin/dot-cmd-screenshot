#!/usr/bin/env bash

mkdir -p "$XDG_SCREENSHOTS_DIR"

pkill slurp && exit 0

MODE="${1:-smart}"
PROCESSING="${2:-satty}"

MONITOR='"\(.x),\(.y) \(.width / .scale | floor)x\(.height / .scale | floor)"'

get_rectangles() {
  local ws=$(hyprctl activeworkspace -j | jq '.id')
  hyprctl monitors -j | jq -r ".[] | select(.activeWorkspace.id == $ws) | $MONITOR"
  hyprctl clients -j | jq -r ".[] | select(.workspace.id == $ws) | \"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])\""
}

# Freeze the screen so open menus survive the selection click. It has to stay up
# until grim has captured, since grim records the frozen frame, not the live one
freeze() {
  hyprpicker -r -z >/dev/null 2>&1 & FREEZE_PID=$!
  sleep .1
}
unfreeze() {
  kill $FREEZE_PID 2>/dev/null
}
trap unfreeze EXIT

case "$MODE" in
  region)
    freeze
    SELECTION=$(slurp 2>/dev/null)
    ;;
  windows)
    freeze
    SELECTION=$(get_rectangles | slurp -r 2>/dev/null)
    ;;
  fullscreen)
    SELECTION=$(hyprctl monitors -j | jq -r ".[] | select(.focused) | $MONITOR")
    ;;
  smart|*)
    RECTS=$(get_rectangles)
    freeze
    SELECTION=$(slurp <<< "$RECTS" 2>/dev/null)

    # A selection under 20px² is a slipped click, not a region: take the first
    # rectangle it falls in to prevent accidental 2px snapshots
    if [[ $SELECTION =~ ^(-?[0-9]+),(-?[0-9]+)\ ([0-9]+)x([0-9]+)$ ]] && (( BASH_REMATCH[3] * BASH_REMATCH[4] < 20 )); then
      SELECTION=$(awk -v x="${BASH_REMATCH[1]}" -v y="${BASH_REMATCH[2]}" '
        { split($1, p, ","); split($2, s, "x") }
        x >= p[1] && x < p[1] + s[1] && y >= p[2] && y < p[2] + s[2] { print $1, $2; exit }
      ' <<< "$RECTS")
    fi
    ;;
esac

[ -z "$SELECTION" ] && exit 0

if [[ $PROCESSING == "satty" ]]; then
  IMAGE=$(mktemp --suffix=.png)
  grim -g "$SELECTION" "$IMAGE"
  unfreeze
  satty --filename "$IMAGE" \
        --early-exit \
        --save-after-copy \
        --actions-on-enter save-to-clipboard \
        --copy-command wl-copy \
        --annotation-size-factor 0.5 \
        --output-filename "$XDG_SCREENSHOTS_DIR/screenshot_$(date '+%Y-%m-%d_%H%M%S').png"
  rm -f "$IMAGE"
else
  grim -g "$SELECTION" - | wl-copy
fi
