#!/bin/sh

CHOSEN=$(printf "Lock\nSuspend\nReboot\nShutdown\nLog Out" | varde launcher --dmenu -p "System...")

case "$CHOSEN" in
    "Lock") dot-cmd-lockscreen ;;
    "Suspend") systemctl suspend ;;
    "Reboot") hyprshutdown; systemctl reboot --no-wall ;;
    "Shutdown") hyprshutdown; systemctl poweroff --no-wall ;;
    "Log Out") uwsm stop ;;
    *) exit 1 ;;
esac
