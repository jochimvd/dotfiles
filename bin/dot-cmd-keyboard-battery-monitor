#!/usr/bin/env bash

# Print the battery level of every half of the connected ZMK split keyboards, and
# notify when one is below the threshold given with -t.
#
# ZMK exposes the central's own level as a battery level characteristic without a
# user description, and proxies each peripheral's level as one described
# "Peripheral N" (CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY). With one
# peripheral the central is the left half; with two the central is a dongle
# without a battery, and peripheral 0 and 1 are assumed to be left and right.

usage() {
  echo "Usage: ${0##*/} [-t threshold_percentage]"
  echo "  -t PERCENT  Notify when a battery is below PERCENT"
}

THRESHOLD=
while getopts ":t:h" opt; do
  case $opt in
    t)
      THRESHOLD=$OPTARG
      if ! [[ $THRESHOLD =~ ^[0-9]+$ ]] || (( THRESHOLD < 1 || THRESHOLD > 100 )); then
        echo "Threshold must be a number between 1 and 100" >&2
        exit 1
      fi
      ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
  esac
done

busctl --system --json=short call org.bluez / org.freedesktop.DBus.ObjectManager GetManagedObjects |
  jq -r '
    .data[0] as $o
    | [$o | keys[] | select($o[.]["org.bluez.GattDescriptor1"].UUID.data == "00002901-0000-1000-8000-00805f9b34fb")
        | sub("/desc[^/]*$"; "")] as $described
    | [$o | keys[] | select($o[.]["org.bluez.GattCharacteristic1"].UUID.data == "00002a19-0000-1000-8000-00805f9b34fb")]
    | group_by(sub("/service.*"; ""))[]
    | (.[0] | sub("/service.*"; "")) as $device
    | select($o[$device]["org.bluez.Device1"].Connected.data)
    | map(select(IN($described[]))) as $peripherals
    | (map(select(IN($described[]) | not)) | if ($peripherals | length) > 1 then [] else . end) as $central
    | if ($peripherals | length) == 0 then $central | map([., ""])
      elif ($peripherals | length) == 1 then [[$central[0], "left"], [$peripherals[0], "right"]]
      else $peripherals | to_entries | map([.value, ["left", "right"][.key] // "peripheral \(.key)"])
      end
    | .[] | select(.[0]) | [.[0], $o[$device]["org.bluez.Device1"].Alias.data, .[1]] | @tsv' |
  while IFS=$'\t' read -r path name half; do
    level=$(busctl --system --json=short call org.bluez "$path" org.bluez.GattCharacteristic1 ReadValue 'a{sv}' 0 |
      jq '.data[0][0] // empty')
    echo "$name${half:+ $half}: ${level:-N/A}%"

    if [[ -n $THRESHOLD && -n $level ]] && (( level < THRESHOLD )); then
      notify-send -u critical "Keyboard Battery Low" "The $name${half:+ $half half} battery is at $level%."
    fi
  done
